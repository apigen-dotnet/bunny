<Project>
  <PropertyGroup>
    <Authors>Frank Hommers</Authors>
    <Company>Initialize.nl</Company>
    <Copyright>Copyright (c) Frank Hommers / Initialize.nl</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/apigen-dotnet/bunny</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apigen-dotnet/bunny</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Apigen.Bunny'">
    <IsPackable>true</IsPackable>
    <PackageId>Apigen.Bunny</PackageId>
    <Version>1.0.0</Version>
    <Description>Generated C# clients for all eight bunny.net APIs in one package: Core, Origin Errors, CDN Logging, Storage, Stream, Shield, Edge Scripting and Magic Containers.</Description>
    <PackageTags>bunny;bunny-net;cdn;storage;stream;dns;containers;api;client;openapi;apigen</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Apigen.Bunny'">
    <None Include="../../README.md" Pack="true" PackagePath="/" Condition="Exists('../../README.md')" />
  </ItemGroup>
</Project>
